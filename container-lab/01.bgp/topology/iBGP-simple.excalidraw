      "created": 1793597586556,
      "link": null,
      "locked": false,
      "text": "SRL2 BGP config:\n\nA:srl2# set network-instance default protocols bgp admin-state enable\nA:srl2# set network-instance default protocols bgp router-id 1.1.1.1\nA:srl2# set network-instance default protocols bgp autonomous-system 65001\nA:srl2# set network-instance default protocols bgp group EBGP-internal admin-state enable\nA:srl2# set network-instance default protocols bgp neighbor 10.0.1.1\nA:srl2# set network-instance default protocols bgp neighbor 10.0.1.1 peer-group EBGP-internal\nA:srl2# set network-instance default protocols bgp neighbor 10.0.1.1 peer-as 65001\nA:srl2# set / network-instance default protocols bgp afi-safi ipv4-unicast admin-state enable",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SRL2 BGP config:\n\nA:srl2# set network-instance default protocols bgp admin-state enable\nA:srl2# set network-instance default protocols bgp router-id 1.1.1.1\nA:srl2# set network-instance default protocols bgp autonomous-system 65001\nA:srl2# set network-instance default protocols bgp group EBGP-internal admin-state enable\nA:srl2# set network-instance default protocols bgp neighbor 10.0.1.1\nA:srl2# set network-instance default protocols bgp neighbor 10.0.1.1 peer-group EBGP-internal\nA:srl2# set network-instance default protocols bgp neighbor 10.0.1.1 peer-as 65001\nA:srl2# set / network-instance default protocols bgp afi-safi ipv4-unicast admin-state enable",
      "autoResize": true,
