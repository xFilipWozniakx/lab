      "link": null,
      "locked": false,
      "text": "    routing-policy {\n        prefix-set transit-networks {\n            prefix 10.0.1.0/24 mask-length-range exact {\n            }\n            prefix 10.0.2.0/24 mask-length-range exact {\n            }\n        }\n        policy accept-all {\n            statement 10 {\n                action {\n                    policy-result accept\n                }\n            }\n        }\n        policy advertise-transits {\n            default-action {\n                policy-result next-policy\n            }\n            statement 10 {\n                match {\n                    prefix-set transit-networks\n                }\n                action {\n                    policy-result accept\n                }\n            }\n        }\n    }",
