      "updated": 1793722488152,
      "created": 1793623326896,
      "link": null,
      "locked": false,
      "text": "BGP PRE-RR CLUSTER-CLIENT RELATION CONFIGURATION\n    network-instance default {\n        protocols {\n            bgp {\n                admin-state enable\n                autonomous-system 65001\n                router-id 1.1.1.2\n                export-policy [\n                    advertise-to-srl2\n                ]\n                import-policy [\n                    accept-all\n                ]\n                afi-safi ipv4-unicast {\n                    admin-state enable\n                }\n                group EBGP-internal {\n                    admin-state enable\n                }\n                neighbor 10.0.1.2 {\n                    peer-as 65001\n                    peer-group EBGP-internal\n                }\n            }\n        }\n    }",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "BGP PRE-RR CLUSTER-CLIENT RELATION CONFIGURATION\n    network-instance default {\n        protocols {\n            bgp {\n                admin-state enable\n                autonomous-system 65001\n                router-id 1.1.1.2\n                export-policy [\n                    advertise-to-srl2\n                ]\n                import-policy [\n                    accept-all\n                ]\n                afi-safi ipv4-unicast {\n                    admin-state enable\n                }\n                group EBGP-internal {\n                    admin-state enable\n                }\n                neighbor 10.0.1.2 {\n                    peer-as 65001\n                    peer-group EBGP-internal\n                }\n            }\n        }\n    }",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "hrPomPCagYExVKAZBVacK",
      "type": "text",
      "x": 1323.994140625,
      "y": -2076.7121465773807,
      "width": 638.37890625,
      "height": 1050,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
