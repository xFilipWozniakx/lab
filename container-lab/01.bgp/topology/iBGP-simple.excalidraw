      "updated": 1793722519612,
      "created": 1793617038631,
      "link": null,
      "locked": false,
      "text": "policy config for srl2: but works for but with minor differences\nset / routing-policy prefix-set host2-local prefix 10.1.5.0/24 mask-length-range\nexact\nset / routing-policy policy advertise-to-srl1 statement 10 action policy-result\naccept\nset / network-instance default protocols bgp export-policy [ advertise-to-srl1 ]\nneighbor 10.0.1.1\nset / routing-policy policy accept-all statement 10 action policy-result accept\nset / network-instance default protocols bgp import-policy [ accept-all ] neighbor\n10.0.1.1",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "policy config for srl2: but works for but with minor differences\nset / routing-policy prefix-set host2-local prefix 10.1.5.0/24 mask-length-range exact\nset / routing-policy policy advertise-to-srl1 statement 10 action policy-result accept\nset / network-instance default protocols bgp export-policy [ advertise-to-srl1 ] neighbor 10.0.1.1\nset / routing-policy policy accept-all statement 10 action policy-result accept\nset / network-instance default protocols bgp import-policy [ accept-all ] neighbor 10.0.1.1",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
