      "version": 85,
      "versionNonce": 616835012,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793722595509,
      "created": 1793722584309,
      "link": null,
      "locked": false,
      "text": "\n    network-instance default {\n        protocols {\n            bgp {\n                autonomous-system 65001\n                router-id 1.1.1.2\n                export-policy [\n                    advertise-transits\n                    accept-all\n                ]\n                import-policy [\n                    accept-all\n                ]\n                afi-safi ipv4-unicast {\n                    admin-state enable\n                }\n                route-reflector {\n                    cluster-id 0.0.0.1\n                }\n                group EBGP-internal {\n                    admin-state enable\n                }\n                neighbor 10.0.1.2 {\n                    peer-as 65001\n                    peer-group EBGP-internal\n                    route-reflector {\n                        client true\n                        cluster-id 0.0.0.1\n                    }\n                }\n                neighbor 10.0.2.2 {\n                    admin-state enable\n                    peer-as 65001\n                    peer-group EBGP-internal\n                    route-reflector {\n                        client true\n                        cluster-id 0.0.0.1\n                    }\n                }\n            }\n        }\n    }",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\n    network-instance default {\n        protocols {\n            bgp {\n                autonomous-system 65001\n                router-id 1.1.1.2\n                export-policy [\n                    advertise-transits\n                    accept-all\n                ]\n                import-policy [\n                    accept-all\n                ]\n                afi-safi ipv4-unicast {\n                    admin-state enable\n                }\n                route-reflector {\n                    cluster-id 0.0.0.1\n                }\n                group EBGP-internal {\n                    admin-state enable\n                }\n                neighbor 10.0.1.2 {\n                    peer-as 65001\n                    peer-group EBGP-internal\n                    route-reflector {\n                        client true\n                        cluster-id 0.0.0.1\n                    }\n                }\n                neighbor 10.0.2.2 {\n                    admin-state enable\n                    peer-as 65001\n                    peer-group EBGP-internal\n                    route-reflector {\n                        client true\n                        cluster-id 0.0.0.1\n                    }\n                }\n            }\n        }\n    }",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
