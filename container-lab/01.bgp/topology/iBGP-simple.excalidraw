      "text": "SRL1 BGP config:\n\nA:srl1# enter candidate\nA:srl1# set / network-instance default protocols bgp admin-state enable\nA:srl1# set / network-instance default protocols bgp router-id 1.1.1.2\nA:srl1# set / network-instance default protocols bgp autonomous-system 65001\nA:srl1# set / network-instance default protocols bgp group EBGP-internal admin-state enable\nA:srl1# set / network-instance default protocols bgp neighbor 10.0.1.2\nA:srl1# set / network-instance default protocols bgp neighbor 10.0.1.2 peer-group EBGP-internal\nA:srl1# set / network-instance default protocols bgp neighbor 10.0.1.2 peer-as 65001\nA:srl1# set / network-instance default protocols bgp afi-safi ipv4-unicast admin-state enable",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SRL1 BGP config:\n\nA:srl1# enter candidate\nA:srl1# set / network-instance default protocols bgp admin-state enable\nA:srl1# set / network-instance default protocols bgp router-id 1.1.1.2\nA:srl1# set / network-instance default protocols bgp autonomous-system 65001\nA:srl1# set / network-instance default protocols bgp group EBGP-internal admin-state enable\nA:srl1# set / network-instance default protocols bgp neighbor 10.0.1.2\nA:srl1# set / network-instance default protocols bgp neighbor 10.0.1.2 peer-group EBGP-internal\nA:srl1# set / network-instance default protocols bgp neighbor 10.0.1.2 peer-as 65001\nA:srl1# set / network-instance default protocols bgp afi-safi ipv4-unicast admin-state enable",
